#!/usr/bin/env bash
set -euo pipefail

app_root="${DESKALLY_HOME:-$HOME/.local/share/deskally}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/deskally"
pid_file="$state_dir/panel.pid"
log_file="$state_dir/panel.log"
runner="${DESKALLY_RUNNER:-$HOME/.local/libexec/deskally-app}"

usage() {
  cat <<'EOF'
Usage: deskally COMMAND

  start                 Start the panel
  stop                  Stop the panel
  restart               Restart the panel
  status                Show status
  logs                  Show recent logs
  color COLOR           Change the accent color
  version               Show version
  help                  Show this help

Colors: cyan, blue, red, green, purple, gold or #RRGGBB
Turkish command and color aliases are also supported.

Example: deskally color blue
EOF
}

is_running() {
  [[ -s "$pid_file" ]] || return 1
  local pid
  pid="$(cat "$pid_file")"
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null
}

start_panel() {
  mkdir -p "$state_dir"
  if is_running; then
    echo "DeskALLY is already running."
    return 0
  fi
  rm -f "$pid_file"
  nohup "$runner" </dev/null >>"$log_file" 2>&1 &
  for _ in {1..40}; do
    if is_running; then
      echo "DeskALLY started."
      return 0
    fi
    sleep 0.1
  done
  echo "Could not start the panel. Log: $log_file" >&2
  return 1
}

stop_panel() {
  if is_running; then
    local pid
    pid="$(cat "$pid_file")"
    kill "$pid" 2>/dev/null || true
    for _ in {1..40}; do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
    done
    if kill -0 "$pid" 2>/dev/null; then
      kill -KILL "$pid" 2>/dev/null || true
      sleep 0.2
    fi
  fi
  rm -f "$pid_file"
  echo "DeskALLY stopped."
}

show_status() {
  if is_running; then
    echo "DeskALLY is running (PID $(cat "$pid_file"))."
  else
    echo "DeskALLY is not running."
    return 1
  fi
}

set_color() {
  if [[ $# -ne 1 ]]; then
    echo "Usage: deskally color COLOR" >&2
    return 2
  fi
  PYTHONPATH="$app_root${PYTHONPATH:+:$PYTHONPATH}" \
    python3 -m deskally.theme "$1"
  stop_panel >/dev/null
  start_panel
}

case "${1:-help}" in
  start|baslat) start_panel ;;
  stop|durdur) stop_panel ;;
  restart|yenile) stop_panel; start_panel ;;
  status|durum) show_status ;;
  logs|gunluk)
    if [[ -f "$log_file" ]]; then
      tail -n 100 "$log_file"
    else
      echo "No logs yet."
    fi
    ;;
  color|renk) shift; set_color "$@" ;;
  version|surum)
    PYTHONPATH="$app_root${PYTHONPATH:+:$PYTHONPATH}" \
      python3 -c 'from deskally import __version__; print(__version__)'
    ;;
  help|-h|--help|yardim) usage ;;
  *) echo "Unknown command: $1" >&2; usage >&2; exit 2 ;;
esac
