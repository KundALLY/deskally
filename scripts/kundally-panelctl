#!/usr/bin/env bash
set -euo pipefail

app_root="${KUNDALLY_PANEL_HOME:-$HOME/.local/share/kundally-panel}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/kundally-panel"
pid_file="$state_dir/panel.pid"
log_file="$state_dir/panel.log"
launcher="${KUNDALLY_PANEL_LAUNCHER:-$HOME/.local/bin/kundally-panel}"

is_running() {
  [[ -s "$pid_file" ]] || return 1
  local pid
  pid="$(cat "$pid_file")"
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null
}

start_panel() {
  mkdir -p "$state_dir"
  if is_running; then
    echo "KundALLY Panel zaten çalışıyor."
    return 0
  fi
  rm -f "$pid_file"
  nohup "$launcher" </dev/null >>"$log_file" 2>&1 &
  for _ in {1..40}; do
    if is_running; then
      echo "KundALLY Panel başlatıldı."
      return 0
    fi
    sleep 0.1
  done
  echo "Panel başlatılamadı. Günlük: $log_file" >&2
  return 1
}

stop_panel() {
  if is_running; then
    local pid
    pid="$(cat "$pid_file")"
    kill "$pid"
    for _ in {1..40}; do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
    done
  fi
  rm -f "$pid_file"
  echo "KundALLY Panel kapatıldı."
}

case "${1:-start}" in
  start) start_panel ;;
  stop) stop_panel ;;
  restart) stop_panel; start_panel ;;
  status)
    if is_running; then
      echo "KundALLY Panel çalışıyor (PID $(cat "$pid_file"))."
    else
      echo "KundALLY Panel çalışmıyor."
      exit 1
    fi
    ;;
  logs) tail -n 100 "$log_file" ;;
  *) echo "Kullanım: kundally-panelctl {start|stop|restart|status|logs}" >&2; exit 2 ;;
esac
